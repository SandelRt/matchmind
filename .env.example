# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# ── Gemini API ─────────────────────────────────────────────────────────────────
# Option A: Google AI Studio (simpler — get key at https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Option B: Vertex AI (requires: gcloud auth application-default login)
# Comment out the two lines above and set GOOGLE_GENAI_USE_VERTEXAI=true (or remove it)
# GOOGLE_GENAI_USE_VERTEXAI=true

# ── Arize Phoenix ─────────